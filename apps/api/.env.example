# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# ==========================================
# MongoDB
# ==========================================
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>?retryWrites=true&w=majority

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=your_jwt_secret
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret
PLATFORM_SECRET=your_platform_secret

# ==========================================
# SMTP (Email)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Render blocks outbound SMTP (25/465/587). Set this and mail goes over the
# Resend HTTPS API instead — required for email to work on Render.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Optional escape hatch: force SMTP even when the key above is present
# EMAIL_TRANSPORT=smtp

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Razorpay
# ==========================================
# Test Keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Live Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==========================================
# Redis (Bull Queue)
# ==========================================
# Local
REDIS_URL=redis://127.0.0.1:6379

# Production Example
# REDIS_URL=rediss://default:<PASSWORD>@<HOST>:<PORT>

# ==========================================
# Optional Settings
# ==========================================
# LOG_LEVEL=info
# CORS_ORIGIN=http://localhost:3000
# APP_NAME=Production ERP
# APP_VERSION=1.0.0