# ==========================================
# API origin
# ==========================================
# VITE_PORT is the origin the app calls, despite the name — every API slice
# builds its URLs as `${VITE_PORT}/api/v1/...`. Leave it EMPTY in production so
# requests stay relative and hit the Vercel /api rewrite, which proxies to
# Render and keeps the auth cookies first-party.
VITE_PORT=http://localhost:4000

# Used by the OASES socket client, which throws on startup if this is unset,
# and as a fallback wherever VITE_PORT is missing.
VITE_API_URL=http://localhost:4000

# Read only by the server-health poller (shared/hooks/useServerHealth.js).
VITE_API_BASE_URL=http://localhost:4000
